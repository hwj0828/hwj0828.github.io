---
---
<div class="row">
  <div class="col-sm-2 date">
    {% if entry.month %}
      {{ entry.month | capitalize }}
    {% endif %}
    {% if entry.day %}
      {{ entry.day }},
    {% endif %}
    {% if entry.year %}
      {{ entry.year }}
    {% endif %}
  </div>
  <div id="{{ entry.key }}" class="col-sm-10 details">
    <div class="title" style="font-weight: bold; font-size: 1.2rem;">
      {% if entry.pdf %}
        {% if entry.pdf contains '://' %}
          <a href="{{ entry.pdf }}" target="_blank">{{ entry.title }}</a>
        {% else %}
          <a href="{{ entry.pdf | prepend: '/assets/pdf/' | relative_url }}" target="_blank">{{ entry.title }}</a>
        {% endif %}
      {% elsif entry.slides %}
        {% if entry.slides contains '://' %}
          <a href="{{ entry.slides }}" target="_blank">{{ entry.title }}</a>
        {% else %}
          <a href="{{ entry.slides | prepend: '/assets/pdf/' | relative_url }}" target="_blank">{{ entry.title }}</a>
        {% endif %}
      {% else %}
        {{ entry.title }}
      {% endif %}
    </div>
    <div class="talk-note" style="font-size: 0.9rem;">
      {{ entry.note }}
    </div>
  </div>
</div>
