---
---
<div class="row">
  <div id="{{ entry.key }}" class="col-sm-12">
    <!-- Month Year. Title. Note. -->
    {% if entry.month %}
      {{ entry.month | capitalize | slice: 0, 3 }}
    {% endif %}
    {% if entry.day %}
      {{ entry.day }},
    {% endif %}
    {% if entry.year %}
      {{ entry.year }}.
    {% endif %}
    
    {{ entry.title }}.
    
    {% if entry.note %}
      {{ entry.note }}.
    {% endif %}
  </div>
</div>
